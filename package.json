{
  "name": "@davidaayers/opencode-context-gauge-plugin",
  "version": "0.1.8",
  "packageManager": "pnpm@10.33.0",
  "description": "OpenCode TUI sidebar plugin: live context-window usage gauge for the active session",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist/tui.js"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "context",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaayers/opencode-context-gauge-plugin.git"
  },
  "bugs": "https://github.com/davidaayers/opencode-context-gauge-plugin/issues",
  "homepage": "https://github.com/davidaayers/opencode-context-gauge-plugin#readme",
  "scripts": {
    "build": "bun build.mjs",
    "prepack": "bun build.mjs",
    "test": "bun test src",
    "test:pack": "bun test --conditions=browser packed-install.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run test:pack"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "@opentui/core": "^0.5.6",
    "@opentui/solid": "^0.5.6",
    "solid-js": "^1.9.9",
    "@opencode-ai/sdk": "^1.18.21",
    "typescript": "^5.9.2"
  }
}
