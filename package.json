{
  "name": "@davidaayers/opencode-context-gauge-plugin",
  "version": "1.0.1",
  "packageManager": "pnpm@10.33.0",
  "description": "OpenCode TUI sidebar plugin: live context-window usage gauge for the active session",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "context",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaayers/opencode-context-gauge-plugin.git"
  },
  "bugs": "https://github.com/davidaayers/opencode-context-gauge-plugin/issues",
  "homepage": "https://github.com/davidaayers/opencode-context-gauge-plugin#readme",
  "engines": {
    "opencode": ">=2.1.3 <3"
  },
  "scripts": {
    "build": "bun build.mjs",
    "prepack": "bun build.mjs",
    "test": "bun test src",
    "test:pack": "bun test --conditions=browser packed-install.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm test:pack"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.3",
    "@opencode/theme": "2.1.3",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.2"
  }
}
